# ============================================================================
# HappyClass – biến môi trường. Sao chép thành .env, KHÔNG commit .env.
# Mọi mật khẩu dưới đây là ví dụ; tạo giá trị mới bằng: openssl rand -base64 32
# ============================================================================

# --- PostgreSQL riêng của HappyClass (không dùng chung với dự án khác) ---
POSTGRES_USER=happyclass
POSTGRES_PASSWORD=change-me
POSTGRES_DB=happyclass
DATABASE_URL=postgresql://happyclass:change-me@postgres:5432/happyclass?schema=public

# --- Gốc URL của từng site ---
# Chạy thử nội bộ (theo đường dẫn):
SITE_ENGLISH_URL=http://localhost:3100/english
SITE_VIETNAMESE_URL=http://localhost:3100/vietnamese
SITE_ADMIN_URL=http://localhost:3100/admin
# Production theo subdomain (khi đã có tên miền happyclass.asia):
# SITE_ENGLISH_URL=https://english.happyclass.asia
# SITE_VIETNAMESE_URL=https://tiengviet.happyclass.asia
# SITE_ADMIN_URL=https://admin.happyclass.asia

# --- Phiên đăng nhập ---
# Để trống khi chạy local. Production: .happyclass.asia (dùng chung giữa các subdomain)
COOKIE_DOMAIN=
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
# Số proxy đứng trước API: Next.js (1) + Caddy (1) = 2
TRUST_PROXY_HOPS=1
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Email: log (dev, in ra console) | smtp (thật) ---
MAIL_TRANSPORT=log
MAIL_FROM=HappyClass <no-reply@happyclass.asia>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

TERMS_VERSION=2026-11-01

# --- Web gọi API nội bộ ---
API_INTERNAL_URL=http://api:4000/api

# --- Cổng trên máy chủ (chỉ bind 127.0.0.1) ---
HC_WEB_HOST_PORT=3100
HC_API_HOST_PORT=3101
HC_DATA_DIR=/data/education-games-platform
