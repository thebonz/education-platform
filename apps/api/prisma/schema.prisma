// HappyClass – Shared Core schema (Giai đoạn 2)
// Bảng membership, đơn hàng, thanh toán, trường học, offline sẽ được thêm ở
// giai đoạn 6–7 bằng migration riêng, theo thiết kế trong báo cáo kiến trúc.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Sản phẩm (English, Vietnamese, sau này Math...)
// ---------------------------------------------------------------------------

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  name        String
  description String?
  locale      String          @default("vi")
  theme       Json?
  isActive    Boolean         @default(true) @map("is_active")
  domains     ProductDomain[]
  categories  GameCategory[]
  levels      Level[]
  games       Game[]
  plans       Plan[]
  entitlements Entitlement[]
  classrooms  Classroom[]
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("products")
}

model ProductDomain {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  hostname  String   @unique
  isPrimary Boolean  @default(false) @map("is_primary")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("product_domains")
}

// ---------------------------------------------------------------------------
// Danh mục và game (template đầy đủ ở giai đoạn 3)
// ---------------------------------------------------------------------------

enum AccessLevel {
  FREE
  PREMIUM
}

/// Trạng thái duyệt nội dung bởi giáo viên. Mỗi phiên bản nội dung mới quay về PENDING.
enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model GameCategory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  slug      String
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  games     Game[]
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, slug])
  @@map("game_categories")
}

model Level {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  slug      String
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  games     Game[]
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, slug])
  @@map("levels")
}

model Game {
  id          String        @id @default(uuid()) @db.Uuid
  productId   String        @map("product_id") @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  levelId     String?       @map("level_id") @db.Uuid
  slug        String
  title       String
  summary     String
  templateKey String        @map("template_key")
  // Cột cũ từ giai đoạn 2, thay bằng levelId; giữ lại để migration không mất dữ liệu.
  gradeLevel  String?       @map("grade_level")
  difficulty  String?
  accessLevel AccessLevel   @default(PREMIUM) @map("access_level")
  thumbnail   String?
  isPublished Boolean       @default(false) @map("is_published")
  sortOrder   Int           @default(0) @map("sort_order")
  // Seed chỉ cập nhật game còn do seed quản lý; Game Builder (giai đoạn 5) đặt false khi admin sửa.
  managedBySeed Boolean     @default(true) @map("managed_by_seed")
  seedRevision  Int         @default(0) @map("seed_revision")
  reviewStatus  ReviewStatus @default(PENDING) @map("review_status")
  reviewedAt    DateTime?   @map("reviewed_at")
  // Không đặt khóa ngoại: người duyệt có thể bị xóa tài khoản, lịch sử nằm ở audit_logs.
  reviewedById  String?     @map("reviewed_by_id") @db.Uuid
  reviewNote    String?     @map("review_note")
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    GameCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  level       Level?        @relation(fields: [levelId], references: [id], onDelete: SetNull)
  versions    GameVersion[]
  sessions    GameSession[]
  favorites   GameFavorite[]
  classGames  ClassGame[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([productId, slug])
  @@index([productId, isPublished, sortOrder])
  @@index([levelId])
  @@index([reviewStatus])
  @@map("games")
}

/** Kết quả một lần chơi của người dùng đã đăng nhập (không lưu kết quả của khách). */
model GameSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  gameId     String   @map("game_id") @db.Uuid
  score      Int
  maxScore   Int      @map("max_score")
  mistakes   Int      @default(0)
  stars      Int
  durationMs Int      @map("duration_ms")
  /// Mã do trình duyệt sinh cho kết quả chơi offline – chống gửi trùng khi đồng bộ lại.
  clientId   String?  @unique @map("client_id") @db.Uuid
  /// Kết quả chơi khi không có mạng, gửi lên sau (createdAt = lúc chơi).
  offline    Boolean  @default(false)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([gameId, createdAt])
  @@map("game_sessions")
}

model GameFavorite {
  userId    String   @map("user_id") @db.Uuid
  gameId    String   @map("game_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, gameId])
  @@map("game_favorites")
}

model GameVersion {
  id            String   @id @default(uuid()) @db.Uuid
  gameId        String   @map("game_id") @db.Uuid
  versionNumber Int      @map("version_number")
  content       Json
  isPublished   Boolean  @default(false) @map("is_published")
  /// Người tạo phiên bản (null = seed). Không đặt khóa ngoại, lịch sử nằm ở audit_logs.
  createdById   String?  @map("created_by_id") @db.Uuid
  /// Ghi chú ngắn của người soạn cho phiên bản này.
  note          String?
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([gameId, versionNumber])
  @@map("game_versions")
}

// ---------------------------------------------------------------------------
// Gói thành viên, đơn hàng, thanh toán (giai đoạn 6)
// ---------------------------------------------------------------------------

enum BillingPeriod {
  MONTH
  YEAR
}

/// Gói bán cho từng sản phẩm. Giá do quản trị sửa được; đơn hàng lưu lại giá lúc đặt.
model Plan {
  id        String        @id @default(uuid()) @db.Uuid
  productId String        @map("product_id") @db.Uuid
  code      String        @unique
  name      String
  period    BillingPeriod
  months    Int
  priceVnd  Int           @map("price_vnd")
  isActive  Boolean       @default(true) @map("is_active")
  sortOrder Int           @default(0) @map("sort_order")
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  orders    Order[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([productId, isActive, sortOrder])
  @@map("plans")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

/// Đơn mua gói. Mã đơn (code) là nội dung chuyển khoản để đối soát tự động.
model Order {
  id            String      @id @default(uuid()) @db.Uuid
  code          String      @unique
  userId        String      @map("user_id") @db.Uuid
  planId        String      @map("plan_id") @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  planName      String      @map("plan_name")
  months        Int
  amountVnd     Int         @map("amount_vnd")
  status        OrderStatus @default(PENDING)
  expiresAt     DateTime    @map("expires_at")
  paidAt        DateTime?   @map("paid_at")
  paidAmountVnd Int?        @map("paid_amount_vnd")
  /// sepay | manual
  paymentMethod String?     @map("payment_method")
  confirmedById String?     @map("confirmed_by_id") @db.Uuid
  note          String?
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan          Plan        @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlement   Entitlement?
  transactions  BankTransaction[]
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

/// Quyền dùng nội dung trả phí của một sản phẩm trong một khoảng thời gian.
model Entitlement {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  /// order | manual
  source    String
  orderId   String?  @unique @map("order_id") @db.Uuid
  grantedById String? @map("granted_by_id") @db.Uuid
  note      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, productId, endsAt])
  @@map("entitlements")
}

enum BankTransactionStatus {
  MATCHED
  UNMATCHED
  AMOUNT_MISMATCH
  IGNORED
}

/// Giao dịch ngân hàng nhận qua webhook (SePay). Lưu tất cả để đối soát, kể cả giao dịch không khớp đơn.
model BankTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  provider        String
  providerTxId    String                @map("provider_tx_id")
  amountVnd       Int                   @map("amount_vnd")
  content         String
  referenceCode   String?               @map("reference_code")
  transactionDate DateTime?             @map("transaction_date")
  status          BankTransactionStatus
  orderId         String?               @map("order_id") @db.Uuid
  raw             Json
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now()) @map("created_at")

  @@unique([provider, providerTxId])
  @@index([status, createdAt])
  @@map("bank_transactions")
}

// ---------------------------------------------------------------------------
// Lớp học của giáo viên (giai đoạn 7). Học sinh KHÔNG có tài khoản: chỉ biệt danh do giáo viên đặt.
// ---------------------------------------------------------------------------

model Classroom {
  id         String         @id @default(uuid()) @db.Uuid
  ownerId    String         @map("owner_id") @db.Uuid
  productId  String         @map("product_id") @db.Uuid
  name       String
  gradeLabel String?        @map("grade_label")
  /// Mã vào lớp cho học sinh (6 ký tự, không dễ nhầm). Đổi được khi lộ.
  joinCode   String         @unique @map("join_code")
  isArchived Boolean        @default(false) @map("is_archived")
  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  games      ClassGame[]
  students   ClassStudent[]
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([ownerId, isArchived])
  @@map("classrooms")
}

/// Bản sao game của lớp: giáo viên sửa nội dung cho lớp mình, không ảnh hưởng game gốc.
model ClassGame {
  id           String     @id @default(uuid()) @db.Uuid
  classroomId  String     @map("classroom_id") @db.Uuid
  sourceGameId String?    @map("source_game_id") @db.Uuid
  title        String
  templateKey  String     @map("template_key")
  accessLevel  AccessLevel @map("access_level")
  content      Json
  isActive     Boolean    @default(true) @map("is_active")
  sortOrder    Int        @default(0) @map("sort_order")
  classroom    Classroom  @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  sourceGame   Game?      @relation(fields: [sourceGameId], references: [id], onDelete: SetNull)
  plays        ClassPlay[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([classroomId, sortOrder])
  @@map("class_games")
}

model ClassStudent {
  id          String      @id @default(uuid()) @db.Uuid
  classroomId String      @map("classroom_id") @db.Uuid
  nickname    String
  avatar      String      @default("🙂")
  isActive    Boolean     @default(true) @map("is_active")
  classroom   Classroom   @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  plays       ClassPlay[]
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([classroomId])
  @@map("class_students")
}

model ClassPlay {
  id          String        @id @default(uuid()) @db.Uuid
  classGameId String        @map("class_game_id") @db.Uuid
  studentId   String?       @map("student_id") @db.Uuid
  score       Int
  maxScore    Int           @map("max_score")
  mistakes    Int           @default(0)
  stars       Int
  durationMs  Int           @map("duration_ms")
  classGame   ClassGame     @relation(fields: [classGameId], references: [id], onDelete: Cascade)
  student     ClassStudent? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([classGameId, createdAt])
  @@index([studentId, createdAt])
  @@map("class_plays")
}

enum MediaKind {
  IMAGE
  AUDIO
}

/// Ảnh/âm thanh dùng trong game. File lưu trên đĩa theo SHA-256 (trùng nội dung = dùng chung một file).
model MediaAsset {
  id           String    @id @default(uuid()) @db.Uuid
  kind         MediaKind
  mimeType     String    @map("mime_type")
  byteSize     Int       @map("byte_size")
  sha256       String    @unique
  width        Int?
  height       Int?
  originalName String    @map("original_name")
  /// Mô tả ảnh cho trình đọc màn hình; gợi ý điền sẵn khi chọn ảnh trong Game Builder.
  alt          String?
  /// upload | ai – nguồn gốc file, để biết nội dung nào do AI tạo.
  source       String    @default("upload")
  createdById  String?   @map("created_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Tài khoản, phiên đăng nhập, token, đồng ý xử lý dữ liệu
// ---------------------------------------------------------------------------

model User {
  id              String       @id @default(uuid()) @db.Uuid
  email           String       @unique
  passwordHash    String       @map("password_hash")
  displayName     String       @map("display_name")
  emailVerifiedAt DateTime?    @map("email_verified_at")
  isActive        Boolean      @default(true) @map("is_active")
  lockedReason    String?      @map("locked_reason")
  lastLoginAt     DateTime?    @map("last_login_at")
  /// Người dùng tự xoá tài khoản: dữ liệu cá nhân đã bị xoá/ẩn danh, chỉ còn chứng từ thanh toán.
  deletedAt       DateTime?    @map("deleted_at")
  roles           UserRole[]
  sessions        UserSession[]
  tokens          AuthToken[]
  consents        Consent[]
  gameSessions    GameSession[]
  favorites       GameFavorite[]
  orders          Order[]
  entitlements    Entitlement[]
  classrooms      Classroom[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("users")
}

model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  expiresAt  DateTime  @map("expires_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

enum AuthTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([userId, type])
  @@map("auth_tokens")
}

model Consent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  kind        String // terms | privacy | adult_account
  version     String
  acceptedAt  DateTime @default(now()) @map("accepted_at")
  ipAddress   String?  @map("ip_address")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Phân quyền (RBAC). Quyền cụ thể của từng vai trò định nghĩa trong code
// (apps/api/src/rbac/permissions.ts) để review được qua Git.
// ---------------------------------------------------------------------------

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  key         String     @unique
  name        String
  description String?
  users       UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  grantedBy String?  @map("granted_by") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Nhật ký thao tác
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
